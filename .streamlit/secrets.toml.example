# ===========================================================================
# Streamlit secrets 模板
#   本地：复制为 .streamlit/secrets.toml（已在 .gitignore 中，禁止提交）
#   云端：Streamlit Cloud → App settings → Secrets，粘贴下面内容并填真实值
# ===========================================================================

# Tushare 数据接口 token（https://tushare.pro 获取）
TUSHARE_TOKEN = ""

# 以下为本项目预留位；当前版本未使用，保留是为了未来推送/告警扩展
PUSHPLUS_TOKEN = ""
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
OPENAI_API_KEY = ""

# 未来迁移到腾讯云 / 云数据库时使用（当前版本不连接数据库，留空即可）
[database]
host = ""
port = 5432
database = ""
user = ""
password = ""

[database.options]
connect_timeout = 5
